# =========================================================
# Streamlit Community Cloud secrets template.
#
# This file is safe to commit (it has no real values). On Streamlit
# Cloud, do NOT upload this file itself — instead paste its filled-in
# contents into your app's Settings → Secrets box in the dashboard.
# Streamlit exposes whatever you paste there as `st.secrets`, which
# `selfrag/config.py`'s `get_env()` checks before falling back to
# `os.environ` — so the same code works locally (via `.env`) and on
# Cloud (via this) with no changes.
# =========================================================

OLLAMA_API_KEY = "your-ollama-cloud-key"
OLLAMA_CHAT_MODEL = "qwen2.5:3b"
OLLAMA_HOST = "https://ollama.com"

GOOGLE_API_KEY = "your-google-api-key"
GOOGLE_EMBED_MODEL = "models/gemini-embedding-001"
GOOGLE_EMBED_BATCH_SIZE = "50"
GOOGLE_EMBED_MAX_RETRIES = "3"

TAVILY_API_KEY = "your-tavily-key"

CHAT_DB_PATH = "self_rag_chat_history.sqlite3"

LANGCHAIN_TRACING_V2 = "false"
LANGCHAIN_ENDPOINT = "https://api.smith.langchain.com"
LANGCHAIN_API_KEY = ""
LANGCHAIN_PROJECT = "Self_RAG"
